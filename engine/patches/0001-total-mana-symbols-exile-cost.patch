+++ b/forge-gui/src/main/java/forge/gamemodes/match/input/InputSelectEntitiesFromList.java
@@ -124,7 +124,28 @@ public class InputSelectEntitiesFromList<T extends GameEntity> extends InputSele
 
     // might re-define later
     @Override
-    protected boolean hasEnoughTargets() { return selected.size() >= min; }
+    protected boolean hasEnoughTargets() {
+        if (selected.size() < min) {
+            return false;
+        }
+        // "fifteen or more black mana symbols among them": OK only once the chosen cards reach it
+        final int[] symbols = manaSymbolTally();
+        return symbols == null || symbols[0] >= symbols[1];
+    }
+
+    /** For a cost counting mana symbols of a colour among the chosen cards (at least N): {chosen so far, needed}, else null. */
+    @SuppressWarnings("unchecked")
+    private int[] manaSymbolTally() {
+        if (tallyType == null || !tallyType.startsWith("ManaSymbols_") || tally <= 0) {
+            return null;
+        }
+        final String[] parts = tallyType.split("_");
+        if (parts.length < 3 || !(parts[2].equals("GE") || parts[2].equals("GT"))) {
+            return null;
+        }
+        final int sum = CardLists.getTotalChroma((FCollection<Card>) getSelected(), forge.card.MagicColor.fromName(parts[1]));
+        return new int[] {sum, parts[2].equals("GT") ? tally + 1 : tally};
+    }
     @Override
     protected boolean hasAllTargets() { return (massSelectMode == null || massSelectMode == MassSelectMode.NONE) && selected.size() >= max; }
 
